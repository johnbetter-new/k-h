datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  SUPERVISOR
  ADMIN
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LinkRequestStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

model User {
  id BigInt @id
  username String?
  firstName String
  lastName String?
  role Role @default(USER)
  isBanned Boolean @default(false)
  bannedUntil DateTime?
  banReason String?
  isRestricted Boolean @default(false)
  restrictedUntil DateTime?
  restrictionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdCourses Course[] @relation("CourseCreator")
  resources CourseResource[] @relation("ResourceSubmitter")
  suggestions Suggestion[] @relation("UserSuggestions")
  reviewedSuggestions Suggestion[] @relation("SupervisorReviews")
  botSessions BotSession[]
  linkRequestUsers LinkRequestUser[]

  @@map("users")
}

model Course {
  id String @id @default(uuid())
  title String
  normalizedTitle String
  code String?
  normalizedCode String?
  description String?
  isActive Boolean @default(true)
  createdById BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("CourseCreator", fields: [createdById], references: [id])
  aliases CourseAlias[]
  resources CourseResource[]
  suggestions Suggestion[]
  linkRequests LinkRequest[]
  @@index([normalizedTitle])
  @@index([normalizedCode])
  @@index([isActive])
  @@map("courses")
}

model CourseAlias {
  id String @id @default(uuid())
  courseId String
  alias String
  normalizedAlias String
  createdAt DateTime @default(now())
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("course_aliases")
}

model CourseResource {
  id String @id @default(uuid())
  courseId String
  title String?
  link String
  instructor String?
  normalizedInstructor String?
  semester String?
  normalizedSemester String?
  description String?
  submittedById BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submittedBy User @relation("ResourceSubmitter", fields: [submittedById], references: [id])
  @@index([courseId])
  @@index([normalizedInstructor])
  @@index([normalizedSemester])
  @@map("course_resources")
}

model Suggestion {
  id String @id @default(uuid())
  courseId String?
  title String
  normalizedTitle String
  instructor String
  normalizedInstructor String
  semester String
  normalizedSemester String
  link String
  description String?
  status SuggestionStatus @default(PENDING)
  rejectionReason String?
  submittedById BigInt
  reviewedById BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  submittedBy User @relation("UserSuggestions", fields: [submittedById], references: [id])
  reviewedBy User? @relation("SupervisorReviews", fields: [reviewedById], references: [id])
  @@index([courseId])
  @@index([status])
  @@index([normalizedTitle])
  @@map("suggestions")
}

model LinkRequest {
  id String @id @default(uuid())
  courseId String
  normalizedInstructor String
  instructor String
  normalizedSemester String
  semester String
  status LinkRequestStatus @default(ACTIVE)
  channelMessageId Int?
  createdAt DateTime @default(now())
  fulfilledAt DateTime?
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requesters LinkRequestUser[]
  @@index([courseId, normalizedInstructor, normalizedSemester])
  @@index([status])
  @@index([normalizedSemester])
  @@map("link_requests")
}

model LinkRequestUser {
  id String @id @default(uuid())
  requestId String
  userId BigInt
  createdAt DateTime @default(now())
  notifiedAt DateTime?
  request LinkRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([requestId, userId])
  @@index([userId])
  @@map("link_request_users")
}

model BotSession {
  key String @id
  value String @db.Text
  updatedAt DateTime @updatedAt
  userId BigInt?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("bot_sessions")
}
